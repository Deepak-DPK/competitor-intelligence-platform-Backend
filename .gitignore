# ==============================================================
# .gitignore — Backend
# ==============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment secrets — NEVER commit
.env
.env.local
.env.*.local

# Alembic
alembic/versions/__pycache__/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Playwright
playwright/.auth/

# Logs
*.log
logs/
